class Solution {
    public int reverseBits(int n) {
        String s=Long.toBinaryString(n);
        String s1="";
        int p=32-s.length();

        for(int i=s.length()-1;i>=0;i--){
            s1=s1+s.charAt(i);
        }
        for(int i=0;i<p;i++){
            s1=s1+'0';
        }
        int value = Integer.parseInt(s1, 2);
        return value;


    }
}
