class Solution {
    public int[][] flipAndInvertImage(int[][] image) {

        int n = image.length;

        // Go through each row
        for (int i = 0; i < n; i++) {

            // Step 1: Reverse the row
            for (int j = 0; j < n / 2; j++) {

                // Swap elements
                int temp = image[i][j];
                image[i][j] = image[i][n - 1 - j];
                image[i][n - 1 - j] = temp;
            }

            // Step 2: Invert the row
            for (int j = 0; j < n; j++) {

                if (image[i][j] == 0) {
                    image[i][j] = 1;
                } else {
                    image[i][j] = 0;
                }
            }
        }

        return image;
    }
}
