class Solution {

    public boolean isPalindrome(ListNode head) {

        int[] arr = new int[100];  // Values store panna array

        int i = 0;                 // Array index

        while (head != null) {     // List mudiyum varaikkum

            arr[i] = head.val;     // Node value → array

            i++;                    // Next array position

            head = head.next;      // Next node-ku move
        }

        int left = 0;              // First position

        int right = i - 1;         // Last position

        while (left < right) {     // Middle varaikkum

            if (arr[left] != arr[right]) {
                return false;      // Different → not palindrome
            }

            left++;                // Left forward

            right--;               // Right backward
        }

        return true;               // Everything same → palindrome
    }
}
